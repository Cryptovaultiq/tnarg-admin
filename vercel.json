{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/server.js"
    },
    {
      "src": "/applications",
      "dest": "/api/server.js"
    },
    {
      "src": "/chats",
      "dest": "/api/server.js"
    },
    {
      "src": "/auth/(.*)",
      "dest": "/api/server.js"
    },
    {
      "src": "/chats/(.*)",
      "dest": "/api/server.js"
    },
    {
      "src": "/applications/(.*)",
      "dest": "/api/server.js"
    },
    {
      "src": "/upload",
      "dest": "/api/server.js"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/api/server.js"
    },
    {
      "src": "/data/(.*)",
      "dest": "/api/server.js"
    },
    {
      "src": "\\/(.*\\.(js|css|png|jpg|jpeg|svg|ico))",
      "dest": "/$1"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
